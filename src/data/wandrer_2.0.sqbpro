column index="14" value="156"/><column index="15" value="156"/><column index="16" value="148"/><column index="17" value="148"/><column index="18" value="148"/><column index="19" value="61"/><column index="20" value="148"/><column index="21" value="156"/><column index="22" value="148"/><column index="23" value="148"/><column index="24" value="148"/><column index="25" value="123"/><column index="26" value="300"/><column index="27" value="123"/><column index="28" value="105"/></column_widths><filter_values><column index="4" value="hill"/><column index="3" value="new h"/><column index="26" value="1"/></filter_values><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="vw_state_aggregates" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="109"/><column index="2" value="109"/><column index="3" value="117"/><column index="4" value="89"/><column index="5" value="78"/><column index="6" value="103"/><column index="7" value="70"/><column index="8" value="70"/><column index="9" value="78"/><column index="10" value="78"/><column index="11" value="78"/><column index="12" value="66"/><column index="13" value="82"/><column index="14" value="82"/><column index="15" value="82"/><column index="16" value="82"/><column index="17" value="82"/><column index="18" value="105"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="vw_state_geo_data" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="62"/><column index="2" value="58"/><column index="3" value="300"/><column index="4" value="42"/><column index="5" value="65"/><column index="6" value="75"/><column index="7" value="42"/><column index="8" value="163"/><column index="9" value="109"/><column index="10" value="109"/><column index="11" value="105"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="vw_town_geo_data" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="62"/><column index="2" value="42"/><column index="3" value="65"/><column index="4" value="75"/><column index="5" value="59"/><column index="6" value="42"/><column index="7" value="300"/><column index="8" value="156"/><column index="9" value="117"/><column index="10" value="109"/><column index="11" value="109"/><column index="12" value="105"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="vw_unincorporated_aggregates" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort><column index="4" mode="0"/></sort><column_widths><column index="1" value="109"/><column index="2" value="109"/><column index="3" value="117"/><column index="4" value="179"/><column index="5" value="140"/><column index="6" value="89"/><column index="8" value="78"/><column index="9" value="103"/><column index="10" value="66"/><column index="11" value="78"/><column index="12" value="87"/><column index="13" value="102"/><column index="14" value="116"/><column index="15" value="121"/><column index="16" value="82"/><column index="17" value="82"/><column index="18" value="82"/><column index="19" value="82"/><column index="20" value="82"/><column index="21" value="133"/><column index="22" value="192"/><column index="23" value="173"/><column index="24" value="113"/><column index="25" value="152"/><column index="26" value="192"/><column index="27" value="173"/><column index="28" value="176"/><column index="29" value="176"/><column index="30" value="192"/><column index="31" value="173"/></column_widths><filter_values><column index="29" value="&gt;0"/></filter_values><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="vw_visible_towns" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort><column index="2" mode="0"/></sort><column_widths><column index="1" value="210"/><column index="2" value="54"/><column index="3" value="300"/><column index="4" value="109"/><column index="5" value="77"/><column index="6" value="156"/><column index="7" value="156"/><column index="8" value="148"/><column index="9" value="163"/><column index="10" value="148"/><column index="11" value="156"/><column index="12" value="156"/><column index="13" value="156"/><column index="14" value="61"/><column index="15" value="163"/><column index="16" value="148"/><column index="17" value="156"/><column index="18" value="156"/><column index="19" value="156"/><column index="20" value="123"/><column index="21" value="300"/><column index="22" value="53"/><column index="23" value="105"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="Hide non-OSM towns*">-- hide most recent arena_badge (towns) for a given county
 select * from arena_badge
-- update arena_badge set geometries_visible = 0
	where parent_arena_id = 833
	and update_datetime = '2025-05-30 15:16:06.911903'
	and name in (
'Atlantic (Township)',
'Cape Hatteras National Seashore',
'Croatan (Township)',
'East Lake (Township)',
'Fort Raleigh National Historic Site',
'Hatteras (Township)',
'Jockey''s Ridge State Park',
'Kinnakeet (Township)',
'Nags Head (Township)',
'Nags Head (Township)'
)	
	order by update_datetime DESC
	
-- Unhide most recent arena_badge (towns) for a given county where name is in list (from OSM)
select * from arena_badge
-- update arena_badge set geometries_visible = 1
	where parent_arena_id = 833
	and name in (
	'Belmont',
'Caldwell Station',
'Charlotte',
'Colonial Village',
'Cornelius',
'Country Club Heights',
'Davidson',
'Eastover',
'Greenville',
'Highland Creek',
'Huntersville',
'Matthews',
'Mint Hill',
'Pineville',
'Skybrook'
)
	and update_datetime = '2025-05-30 15:16:06.911903'
	order by name

	
	</sql><sql name="Update diagonal">select *
-- 	id, diagonal, update_datetime 
	from arena_badge
	where name like 'Edisto Beach%'
	order by name, update_datetime
	
/*	
update arena_badge
	set diagonal = '{&quot;type&quot;:&quot;LineString&quot;,&quot;coordinates&quot;:[[-80.34147,32.47614],[-80.29811,32.50787]]}'
	where id = 147781
*/
	
select ab.* 
	from arena_badge ab
-- 	inner join arena a on a.arena_id = ab.parent_arena_id
	where diagonal is null
	
select * from arena	where arena_id in (3391, 3417, 3393, 3417)</sql><sql name="Create Unincorporated arena_badge*">with new_values as (	
select towns.update_datetime
	, (select min(id) from arena_badge where name = 'Unincorporated') - 1 as id
	, 'Unincorporated' as name
	, county.arena_id as 'parent_arena_id'
	, 'town' as arena_type
	, county.arena_mileage - sum(towns.length) as 'length'
	, 0 as percentage
	, 1 as geometries_visible
	, 10150 as user_id
	, 1 as map_version_id
	, County.arena_name as 'County'
-- 	, county.arena_mileage
-- 	, sum(towns.actuallength) as 'TotalTownMilesCycled'
	from vw_visible_towns towns
	inner join arena County on County.arena_id = towns.parent_arena_id
	where County = 'Dare County'
-- 	and towns.name != 'Unincorporated'
)
insert into arena_badge (update_datetime,Id,name,parent_arena_id,arena_type,length,percentage,geometries_visible,user_id,map_version_id)
select update_datetime,Id,name,parent_arena_id,arena_type,length,percentage,geometries_visible,user_id,map_version_id
	from new_values
	


</sql><sql name="SQL 5*">select Region, Country, State, sum(TotalTowns) as TotalTowns, sum(CycledTowns) as 'CycledTowns'
		, sum(cast(CycledTowns as real))/sum(cast(TotalTowns as real)) as 'PctTownsCycled'
		, sum(TotalTownMiles) as TotalMiles
        , sum(ActualMiles) as 'ActualMiles', sum(ActualMiles)/sum(TotalTownMiles) as 'ActualPct'
        , CASE WHEN sum(Pct10Deficit) &lt; 0 THEN 0 ELSE sum(Pct10Deficit) END as 'Pct10Deficit'
        , CASE WHEN sum(Pct25Deficit) &lt; 0 THEN 0 ELSE sum(Pct25Deficit) END as 'Pct25Deficit'
    	from vw_county_aggregates
    	where State = &quot;North Carolina&quot;</sql><sql name="vw_current_town_data examples">select region
	, sum(length) as TotalMiles
	from vw_current_town_data
	group by region
	order by region;
	
select region, Country
	, sum(length) as TotalMiles
	from vw_current_town_data
	group by region, Country
	order by region, Country;
	
select region, Country, state
	, sum(length) as TotalMiles
	from vw_current_town_data
	group by region, Country, state
	order by region, Country, state;
	
select region, Country, state, County
	, sum(length) as TotalMiles
	from vw_current_town_data
	group by region, Country, state, County
	order by region, Country, state, County;
	
</sql><sql name="SQL 8">select distinct fqtn.Region, fqtn.Country, fqtn.State, REPLACE(fqtn.County, ' County', '') as County, fqtn.name as Town 
		, fqtn.LongCounty, fqtn.long_name
		, round(fqtn.length, 7) as TotalMiles
		, round(fqtn.percentage, 7) as ActualPct, round(fqtn.ActualLength, 7) as ActualMiles
		, round(fqtn.Pct10, 7) as Pct10, round(fqtn.Pct25, 7) as Pct25, round(fqtn.Pct50, 7) as Pct50
        , round(fqtn.Pct75, 7) as Pct75, round(fqtn.Pct90, 7) as Pct90, fqtn.awarded
        , CASE WHEN fqtn.Pct10Deficit &lt; 0 THEN 0 ELSE round(fqtn.Pct10Deficit, 7) END as Pct10Deficit
        , CASE WHEN fqtn.Pct25Deficit &lt; 0 THEN 0 ELSE round(fqtn.Pct25Deficit, 7) END as Pct25Deficit
        , round(fqtn.Pct50Deficit, 7) as Pct50Deficit, round(fqtn.Pct75Deficit, 7) as Pct75Deficit
        , round(fqtn.Pct90Deficit, 7) as Pct90Deficit
		, fqtn.geometries_visible, fqtn.diagonal, fqtn.user_id
        from arena_badge town
		inner join vw_current_town_data fqtn on fqtn.id = town.id 
        where fqtn.state in ('South Carolina')
        order by fqtn.region, fqtn.country, fqtn.state, fqtn.county, fqtn.name		
		</sql><sql name="SQL 9">select region.arena_name as 'Region', country.arena_name as 'Country', state.arena_name as 'State'
	, county.arena_name as County
	, state.arena_id as StateArenaId
	, county.arena_id as CountyArenaId
	, round(county.total, 2) as 'TotalTowns'
-- 	, round(county.arena_mileage, 2) as 'TotalCountyMiles'
	, round(sum(town.length), 2) as 'TotalMiles'
-- 	, round((county.arena_mileage - sum(town.length)), 2) as 'CountyUnincorporatedMiles'
	, round(sum(town.Pct10), 2) as 'Pct10'
	, round(sum(town.Pct25), 2) as 'Pct25'
	, round(sum(town.Pct50), 2) as 'Pct50'
	, round(sum(town.Pct75), 2) as 'Pct75'
	, round(sum(town.ActualLength), 2) as 'ActualMiles'
	, round(sum(town.ActualLength)/sum(town.length), 4) as 'ActualPct'
	, round(sum(town.Pct10Deficit), 2) as 'Pct10Deficit'
	, round(sum(town.Pct25Deficit), 2) as 'Pct25Deficit'
	, round(sum(town.Pct50Deficit), 2) as 'Pct50Deficit'
	, round(sum(town.Pct75Deficit), 2) as 'Pct75Deficit'
	, round(sum(town.Pct90Deficit), 2) as 'Pct90Deficit'
	, county.map_version_id
	from vw_current_town_data vwt
-- 	from arena_badge town
-- 	inner join arena county on county.arena_id = town.parent_arena_id
-- 	inner join arena state on state.arena_id = county.parent_arena_id
-- 	inner join arena country on country.arena_id = state.parent_arena_id
-- 	inner join arena region on region.arena_id = country.parent_arena_id
-- 	where (town.id, town.update_datetime) in
-- 		(
-- 			select id, max(update_datetime) from arena_badge
-- 				group by id
-- 		)
-- 		and name not in ('Appalachian Trail', 'Bartram Trail', 'Benton MacKaye Trail')
-- 
	and State = 'South Carolina'
-- 		and town.name &lt;&gt; 'Unincorporated'
	group by region, country, State, County
	--, town.parent_arena_id
	order by region, country, State, County</sql><sql name="SQL 11*">select Region, Country, State, County as LongCounty
	, REPLACE(County, &quot; County&quot;, &quot;&quot;) as County, StateArenaId, CountyArenaId
	, TotalTowns, CycledTowns, TotalTownMiles, ActualPct, ActualMiles, Pct10, Pct25, Pct50, Pct75
	, CASE WHEN Pct10Deficit &lt; 0 THEN 0 ELSE Pct10Deficit END as Pct10Deficit
	, CASE WHEN Pct25Deficit &lt; 0 THEN 0 ELSE Pct25Deficit END as Pct25Deficit
	, Pct50Deficit, Pct75Deficit, Pct90Deficit
    , UnincorporatedMiles, PctUnincorporatedMilesCycled, UnincorporatedMilesCycled
    , TotalCountyMiles, TotalCountyMilesCycled, PctCountyMilesCycled
	from vw_unincorporated_aggregates
	where State in ('North Carolina')
	order by region, country, State, County</sql><sql name="Edit View vw_current_town_data*">-- DROP VIEW IF EXISTS &quot;main&quot;.&quot;vw_current_town_data&quot;;
-- CREATE VIEW vw_current_town_data as
with towns_in_state as (
select earth.arena_name as Earth, region.arena_name as Region, country.arena_name as Country, state.arena_name as State, REPLACE(county.arena_name, ' County', '') as County
	, county.arena_name as LongCounty
	, lower(replace(state.arena_name || '_' || county.arena_name || '_' || town.name, ' ', '_')) as long_name
	, town.*
	from arena_badge town
	inner join arena county on county.arena_id = town.parent_arena_id
	inner join arena state on state.arena_id = county.parent_arena_id
	inner join arena country on country.arena_id = state.parent_arena_id
	inner join arena region on region.arena_id = country.parent_arena_id
	inner join arena earth on earth.arena_id = region.parent_arena_id
	where State = 'North Carolina'
	and geometries_visible = 1
-- 	and town.name = 'Unincorporated'
	order by Earth, Region, Country, State, County, name	
)
select * from towns_in_state town
	where (town.id, town.update_datetime) in
	(
		select id, max(update_datetime) from arena_badge
			group by id
	)
-- 	order by Region, Country, State, County, name</sql><sql name="Towns &lt; 10% Cycled">select name, length, ActualLength, percentage * 100 as ActualPct, Pct10Deficit, Pct25Deficit 
	from vw_current_town_data
	where state = 'New Hampshire'
	and county = 'Merrimack'
	and Pct25Deficit &gt; 0
	order by Pct25Deficit
	
	
	
</sql><sql name="Edit View vw_county_counts_and_aggregates*">-- DROP VIEW IF EXISTS &quot;main&quot;.&quot;vw_county_counts_and_aggregates&quot;;
-- CREATE VIEW vw_county_counts_and_aggregates as 
with town_counts as (
                select region, country, State, StateArenaId, county, CountyArenaId
                    ,sum(TotalTowns) as TotalTowns, sum(TownsNotCycled) as TownsNotCycled, sum(TownsCycled) as TownsCycled, sum(TownsAwarded) as TownsAwarded
                    , (sum(TownsAwarded) * 1.0/sum(TotalTowns)) as PctTownsAwarded, (sum(TownsCycled) * 1.0/sum(TotalTowns)) as PctTownsCycled
                    , (sum(TownsNotCycled) * 1.0/sum(TotalTowns)) as PctTownsNotCycled
                    from vw_all_town_counts
                    group by state, county
                ),
		county_aggregates as (
			select vca.*
				from vw_county_aggregates vca
					group by vca.State, vca.County
                    order by vca.State, vca.County
)
select distinct tc.*
-- 	, ca.TotalTownMiles, ca.TotalCountyMiles, ca.CountyUnincorporatedMiles
-- 	, ca.Pct10, ca.Pct25, ca.Pct50, ca.Pct75, ca.ActualMiles, ca.ActualPct, ca.Pct10Deficit, ca.Pct25Deficit, ca.Pct50Deficit
	, ca.Pct75Deficit, ca.Pct90Deficit, ca.map_version_id
	from town_counts tc
--	inner join county_aggregates ca on tc.County = ca.County
	inner join county_aggregates ca on tc.CountyArenaId = ca.CountyArenaId
	where tc.State in ('New Hampshire')
-- 	and tc.county = 'Mecklenburg County'
-- 		and ca.CountyUnincorporatedMiles &lt; 0
	group by tc.State, tc.County</sql><sql name="SQL 18*">select Region, Country, State, County as LongCounty
        , REPLACE(County, &quot; County&quot;, &quot;&quot;) as County, StateArenaId, CountyArenaId
        , TotalTowns, CycledTowns, PctTownsCycled, TotalTownMiles, ActualPct, ActualMiles, AchievedTowns
        , PctTownsAchieved, Pct10, Pct25, Pct50, Pct75
        , CASE WHEN Pct10Deficit &lt; 0 THEN 0 ELSE Pct10Deficit END as Pct10Deficit
        , CASE WHEN Pct25Deficit &lt; 0 THEN 0 ELSE Pct25Deficit END as Pct25Deficit
        , Pct50Deficit, Pct75Deficit, Pct90Deficit
        , UnincorporatedMiles, PctUnincorporatedMilesCycled, UnincorporatedMilesCycled
        , Pct10Unincorporated, Pct25Unincorporated
        , CASE WHEN Pct10UnincorporatedDeficit &lt; 0 THEN 0 ELSE Pct10UnincorporatedDeficit END as Pct10UnincorporatedDeficit
        , CASE WHEN Pct25UnincorporatedDeficit &lt; 0 THEN 0 ELSE Pct25UnincorporatedDeficit END as Pct25UnincorporatedDeficit
        , TotalCountyMiles, TotalCountyMilesCycled, PctCountyMilesCycled, 'diagonal'
		from vw_unincorporated_aggregates 
    	where State in ('North Carolina', 'South Carolina')
    	order by region, country, State, County</sql><sql name="SQL 20">/*
select * 
	from arena
	where parent_arena_id = 12
	order by arena_name
*/

-- with const as (
-- 	select 28280.78 as arena_mileage
-- 	)
-- select state.arena_name as 'State'
-- 	, count(*) as 'CountyCount'
-- 	, const.arena_mileage as 'const.arena_mileage'
-- 	, sum(county.arena_mileage), abs(const.arena_mileage - sum(county.arena_mileage)) as diff
-- 	from arena county, const
-- 	inner join arena state on state.arena_id = county.parent_arena_id
-- 	where county.parent_arena_id = 12
	
select a.arena_id, a.arena_name, sum(length) as sum_length, a.arena_mileage
-- 	, sum_length = a.arena_mileage as diff
-- 	, sum(actuallength)
	from arena_badge ab
	inner join arena a on a.arena_id = ab.parent_arena_id
	where (ab.id, ab.update_datetime) in
		(
			select id, max(update_datetime) from arena_badge
				group by id
		)
	and ab.parent_arena_id = 685
	order by ab.name, ab.update_datetime

with county as (select a.arena_id, a.arena_name, sum(length) as sum_length, a.arena_mileage
	from arena_badge ab
	inner join arena a on a.arena_id = ab.parent_arena_id
	where (ab.id, ab.update_datetime) in
		(
			select id, max(update_datetime) from arena_badge
				group by id
		)
	and ab.parent_arena_id = 685
)
select  arena_id, arena_name, sum_length, arena_mileage
	, arena_mileage - sum_length as diff
	from county
	
-- select state.arena_name as 'State'
-- 	, count(*) as 'CountyCount'
-- 	, sum(county.arena_mileage), 28280.78 - sum(county.arena_mileage) as diff
-- 	from arena county
-- 	inner join arena state on state.arena_id = county.parent_arena_id
-- 	where county.parent_arena_id = 12

select Region, Country, State, County as LongCounty
        , REPLACE(County, &quot; County&quot;, &quot;&quot;) as County, StateArenaId, CountyArenaId
        , TotalTowns, TotalTownMiles, ActualPct, ActualMiles, Pct10, Pct25, Pct50, Pct75
        , CASE WHEN Pct10Deficit &lt; 0 THEN 0 ELSE Pct10Deficit END as Pct10Deficit
        , CASE WHEN Pct25Deficit &lt; 0 THEN 0 ELSE Pct25Deficit END as Pct25Deficit
        , Pct50Deficit, Pct75Deficit, Pct90Deficit
        , UnincorporatedMiles, PctUnincorporatedMilesCycled, UnincorporatedMilesCycled
        , TotalCountyMiles, TotalCountyMilesCycled, PctCountyMilesCycled, 'diagonal'
		from vw_unincorporated_aggregates 
    	where State in ('South Carolina')
    	order by region, country, State, County
		
		
	</sql><sql name="Edit View vw_state_aggregates">-- DROP VIEW IF EXISTS &quot;main&quot;.&quot;vw_state_aggregates&quot;;
-- CREATE VIEW vw_state_aggregates as 
select region.arena_name as 'Region', country.arena_name as 'Country', state.arena_name as 'State'
	, state.arena_id as StateArenaId
-- 	, county.arena_id as CountyArenaId
	, round(sum(town.length), 2) as 'TotalMiles'
	, round(sum(town.length), 2) as 'TotalTownMiles'
-- 	, count(town.arena_name) as 'TotalTowns'
	, round(sum(town.Pct10), 2) as 'Pct10'
	, round(sum(town.Pct25), 2) as 'Pct25'
	, round(sum(town.Pct50), 2) as 'Pct50'
	, round(sum(town.Pct75), 2) as 'Pct75'
	, round(sum(town.ActualLength), 2) as 'ActualMiles'
	, round(sum(town.ActualLength)/sum(town.length), 4) as 'ActualPct'
	, round(sum(town.Pct10Deficit), 2) as 'Pct10Deficit'
	, round(sum(town.Pct25Deficit), 2) as 'Pct25Deficit'
	, round(sum(town.Pct50Deficit), 2) as 'Pct50Deficit'
	, round(sum(town.Pct75Deficit), 2) as 'Pct75Deficit'
	, round(sum(town.Pct90Deficit), 2) as 'Pct90Deficit'
	, state.map_version_id
	from arena_badge town
	inner join arena county on county.arena_id = town.parent_arena_id
	inner join arena state on state.arena_id = county.parent_arena_id
	inner join arena country on country.arena_id = state.parent_arena_id
	inner join arena region on region.arena_id = country.parent_arena_id
	group by region, country, State
	order by region, country, State</sql><sql name="Edit View vw_all_town_counts*">-- DROP VIEW IF EXISTS &quot;main&quot;.&quot;vw_all_town_counts&quot;;
-- CREATE VIEW vw_all_town_counts as 
select Earth, EarthArenaId, Region, RegionArenaId, Country, CountryArenaId, State, StateArenaId, County, CountyArenaId
	, sum(TownCount) as 'TotalTowns', sum(NotCycled) as 'TownsNotCycled', sum(Cycled) as 'TownsCycled', sum(Awarded) as 'TownsAwarded'
	, sum(Pct10NotAchieved) as 'lt10Pct', sum(Pct10Achieved) as 'btw10and25Pct', sum(Pct25Achieved) as 'btw25and50Pct'
	, sum(Pct50Achieved) as 'btw50and75Pct', sum(Pct75Achieved) as 'gte75Pct'
	, map_version_id
	FROM (
	select earth.arena_name as 'Earth', earth.arena_id as 'EarthArenaId'
		, region.arena_name as 'Region', region.arena_id as 'RegionArenaId'
		, country.arena_name as 'Country', country.arena_id as 'CountryArenaId'
		, state.arena_name as 'State', state.arena_id as 'StateArenaId'
		, county.arena_name as 'County', county.arena_id as 'CountyArenaId'
		, town.name as 'Town'
		, 1 as 'TownCount'
		, (select case when percentage &gt; 0 then 1 else 0 end ) as 'Cycled'
		, (select case when percentage = 0 then 1 else 0 end ) as 'NotCycled'
		, (select case when percentage &gt; 0 and percentage &lt; .1 then 1 else 0 end ) as 'Pct10NotAchieved'
		, (select case when percentage &gt;= .1 and percentage &lt; .25 then 1 else 0 end ) as 'Pct10Achieved'
		, (select case when percentage &gt;= .25 and percentage &lt; .5 then 1 else 0 end ) as 'Pct25Achieved'
		, (select case when percentage &gt;= .5 and percentage &lt; .75 then 1 else 0 end ) as 'Pct50Achieved'
		, (select case when percentage &gt;= .75 then 1 else 0 end ) as 'Pct75Achieved'
		, town.awarded as 'Awarded'
		, county.map_version_id
		from arena_badge town
		inner join arena county on county.arena_id = town.parent_arena_id
		inner join arena state on state.arena_id = county.parent_arena_id
		inner join arena country on country.arena_id = state.parent_arena_id
		inner join arena region on region.arena_id = country.parent_arena_id
		inner join arena earth on earth.arena_id = region.parent_arena_id
		where (town.id, town.update_datetime) in
			(
				select id, max(update_datetime) from arena_badge
					group by id
			)
	)
-- 	where State = 'New Hampshire'
-- 	where State = 'South Carolina'
	group by earth, region, country, State, County	
	order by earth, region, country, State, County</sql><sql name="SQL 24*">-- DROP VIEW IF EXISTS &quot;main&quot;.&quot;vw_visible_towns&quot;;
-- CREATE VIEW vw_visible_towns as 
select * from arena_badge
	where (id, update_datetime) in
		(
			select id, max(update_datetime) from arena_badge
				group by id
		)
	and geometries_visible = 1
-- 	and parent_arena_id = 3538
	order by parent_arena_id, name

</sql><sql name="SQL 26*">/*
with county_sums as (
	select 
		state.arena_name as 'State', county.arena_name as 'County', County.arena_id as 'CountyId'
		, town.name as 'Town'
-- 		, town.geometries_visible
		, count(*) as 'VisibleTowns'
-- 		, sum(TotalMiles) as 'CountyMIles'
		from arena county
		inner join arena state on state.arena_id = county.parent_arena_id
		inner join vw_visible_towns town on town.parent_arena_id = county.arena_id
-- 		where county.arena_type = 'county'
-- 		and County = 'Mecklenburg County'
		group by State, County, CountyId
)
select State, County, CountyId, VisibleTowns 
	from county_sums
*/

with county_sums as (
select county.arena_name as 'County'
	, county.arena_id as 'CountyId'
-- 	, towns.name as 'Town'
	, count(*) as 'TotalTowns'
	, sum(county.arena_mileage) as 'TotalCountyMiles'
	, sum(towns.length) as 'TotalTownMiles'
	, sum(county.arena_mileage) - sum(towns.length) as 'UnincorporatedCountyMiles'
-- 	, towns.percentage
	, sum(towns.ActualLength) as 'TotalTownMilesCycled'
	, sum(towns.ActualLength) / sum(towns.length) as 'PctTownMilesCycled'
	from vw_visible_towns towns
	inner join arena county on county.arena_id = towns.parent_arena_id
-- 	where county.arena_id = 3538
)
select CountyId, TotalTowns, TotalCountyMiles, TotalTownMiles, UnincorporatedCountyMiles, TotalTownMilesCycled, PctTownMilesCycled
	from county_sums
	where countyid = 1075
-- 	where County = 'Mecklenburg County'

	-- 	group by County, TotalTownMiles, TotalMilesCycled, PctTownMilesCycled, TotalCountyMiles, UnincorporatedMiles
-- 	order by county

</sql><sql name="Edit View fq_town_name*">-- DROP VIEW IF EXISTS &quot;main&quot;.&quot;fq_town_name&quot;;
-- CREATE VIEW fq_town_name as
select distinct town.id as 'arena_id', town.update_datetime, region.arena_name as 'Region', country.arena_name as 'Country', state.arena_name as 'State'
	, replace(county.arena_name, ' County', '') as 'County', county.arena_name as 'long_county'
	, replace(town.name, '-','_') as 'Town'
	, lower(replace(state.arena_name || '_' || county.arena_name || '_' || town.name, ' ', '_')) as long_name
	, town.map_version_id
	from arena_badge town
	inner join arena county on county.arena_id = town.parent_arena_id
	inner join arena state on state.arena_id = county.parent_arena_id
	inner join arena country on country.arena_id = state.parent_arena_id
	inner join arena region on region.arena_id = country.parent_arena_id
	where (town.id, town.update_datetime) in
		(
			select id, max(update_datetime) from arena_badge
				group by id
		)
-- 	and State = 'South Carolina'
-- 	and County = 'Colleton'
	order by State, County, Town</sql><sql name="Edit View fq_county_name*">DROP VIEW IF EXISTS &quot;main&quot;.&quot;fq_county_name&quot;;
CREATE VIEW fq_county_name as
select distinct county.arena_id as 'arena_id', region.arena_name as 'Region', country.arena_name as 'Country', state.arena_name as 'State'
	, replace(county.arena_name, ' County', '') as 'County', county.arena_name as 'long_county'
	, lower(replace(state.arena_name || '_' || replace(county.arena_name, ' County', ''), ' ', '_')) as state_county
	, county.map_version_id
	from arena county
	inner join arena state on state.arena_id = county.parent_arena_id
	inner join arena country on country.arena_id = state.parent_arena_id
	inner join arena region on region.arena_id = country.parent_arena_id
-- 	where country = 'United States'
-- 	where state = 'North Carolina'
	order by Region, Country, State, County</sql><sql name="Edit View vw_unincorporated_aggregates*">-- DROP VIEW IF EXISTS &quot;main&quot;.&quot;vw_unincorporated_aggregates&quot;;
-- CREATE VIEW vw_unincorporated_aggregates as
with unincorporated_miles as (
select 
	fqtn.arena_id, fqtn.update_datetime, fqtn.Region, fqtn.Country 
	,fqtn.State, fqtn.County, fqtn.long_county, fqtn.Town
	, ab.length as UnincorporatedMiles
	, round(ab.percentage, 4) as PctUnincorporatedMilesCycled, round(ab.ActualLength, 2) as UnincorporatedMilesCycled
	from fq_town_name fqtn
	inner join arena_badge ab on ab.id = fqtn.arena_id 
		and ab.update_datetime = fqtn.update_datetime
	where (fqtn.arena_id, fqtn.update_datetime) in
		(
			select id, max(update_datetime) from arena_badge
				group by id
		)
	and fqtn.Town = 'Unincorporated'
	order by fqtn.Region, fqtn.Country, fqtn.State, fqtn.County, fqtn.Town
),
merged_miles as (
select vca.Region, vca.Country, vca.State, vca.County as LongCounty
        , REPLACE(vca.County, &quot; County&quot;, &quot;&quot;) as County, vca.StateArenaId, vca.CountyArenaId, vca.TotalTowns
		, vca.TotalTownMiles, vca.ActualPct, vca.ActualMiles, vca.CycledTowns, vca.AchievedTowns
		, vca.PctTownsCycled, vca.PctTownsAchieved
		, vca.Pct10, vca.Pct25, vca.Pct50, vca.Pct75
        , CASE WHEN vca.Pct10Deficit &lt; 0 THEN 0 ELSE vca.Pct10Deficit END as Pct10Deficit
        , CASE WHEN vca.Pct25Deficit &lt; 0 THEN 0 ELSE vca.Pct25Deficit END as Pct25Deficit
        , vca.Pct50Deficit, vca.Pct75Deficit, vca.Pct90Deficit
		, case when um.UnincorporatedMiles is null then 0 else round(um.UnincorporatedMiles, 2) end as UnincorporatedMiles
		, case when um.UnincorporatedMiles is null then 0 else round(um.UnincorporatedMiles * .1, 2) end as Pct10Unincorporated
		, case when um.UnincorporatedMiles is null then 0 else round(um.UnincorporatedMiles * .25, 2) end as Pct25Unincorporated
		, case when um.UnincorporatedMiles is null then 0 else round(um.UnincorporatedMiles * .1 - um.UnincorporatedMilesCycled, 2) end as Pct10UnincorporatedDeficit
		, case when um.UnincorporatedMiles is null then 0 else round(um.UnincorporatedMiles * .25 - um.UnincorporatedMilesCycled, 2) end as Pct25UnincorporatedDeficit

		, case when um.PctUnincorporatedMilesCycled is null then 0 else um.PctUnincorporatedMilesCycled end as PctUnincorporatedMilesCycled
		, case when um.UnincorporatedMilesCycled is null then 0 else um.UnincorporatedMilesCycled end as UnincorporatedMilesCycled

		, case when um.UnincorporatedMiles is null then vca.TotalTownMiles else vca.TotalTownMiles + um.UnincorporatedMiles end as TotalCountyMiles
		, case when um.UnincorporatedMiles is null then vca.ActualMiles else vca.ActualMiles + um.UnincorporatedMilesCycled end as TotalCountyMilesCycled
		, case when um.UnincorporatedMiles is null then vca.ActualPct else (vca.ActualMiles + UnincorporatedMilesCycled) / (vca.TotalTownMiles + um.UnincorporatedMiles) end as PctCountyMilesCycled
		from vw_county_aggregates vca
		left join unincorporated_miles um 
			on um.long_county = vca.County
			and um.Region = vca.Region
			and um.Country = vca.Country
			and um.State = vca.State
--     	where vca.State in ('New Hampshire', 'South Carolina')
--     	where vca.State in ('New Hampshire')
    	where vca.State in ('North Carolina')
-- 		where vca.AchievedTowns &gt; 0
    	order by vca.Region, vca.Country, vca.State, vca.County
)
select *
	from merged_miles</sql><sql name="Edit View vw_county_aggregates*">-- DROP VIEW IF EXISTS &quot;main&quot;.&quot;vw_county_aggregates&quot;;
-- CREATE VIEW vw_county_aggregates as 
select region.arena_name as 'Region', country.arena_name as 'Country', state.arena_name as 'State'
	, county.arena_name as County
	, state.arena_id as StateArenaId
	, county.arena_id as CountyArenaId
-- 	, county.total as 'TotalTowns'
	, count(*) as 'TotalTowns'
	, sum(town.ActualLength &gt; 0) as 'CycledTowns'
	, round(cast(sum(town.ActualLength &gt; 0) as real) / county.total, 4) as 'PctTownsCycled'
	, county.awarded as 'AchievedTowns'
	, round(cast(county.awarded as real) / county.total, 4) as 'PctTownsAchieved'
	, round(county.arena_mileage, 2) as 'TotalCountyMiles'
	, round(sum(town.length), 2) as 'TotalTownMiles'
	, MAX(0, round(county.arena_mileage - sum(town.length), 2)) as 'UnincorporatedMiles'
	, round(sum(town.Pct10), 2) as 'Pct10'
	, round(sum(town.Pct25), 2) as 'Pct25'
	, round(sum(town.Pct50), 2) as 'Pct50'
	, round(sum(town.Pct75), 2) as 'Pct75'
	, round(sum(town.ActualLength), 2) as 'ActualMiles'
	, round(sum(town.ActualLength)/sum(town.length), 4) as 'ActualPct'
	, round(sum(town.Pct10Deficit), 2) as 'Pct10Deficit'
	, round(sum(town.Pct25Deficit), 2) as 'Pct25Deficit'
	, round(sum(town.Pct50Deficit), 2) as 'Pct50Deficit'
	, round(sum(town.Pct75Deficit), 2) as 'Pct75Deficit'
	, round(sum(town.Pct90Deficit), 2) as 'Pct90Deficit'
	, county.map_version_id
	from vw_visible_towns town
	inner join arena county on county.arena_id = town.parent_arena_id
	inner join arena state on state.arena_id = county.parent_arena_id
	inner join arena country on country.arena_id = state.parent_arena_id
	inner join arena region on region.arena_id = country.parent_arena_id
	where (town.id, town.update_datetime) in
		(
			select id, max(update_datetime) from vw_visible_towns
				group by id
		)
		and name not in ('Appalachian Trail', 'Bartram Trail', 'Benton MacKaye Trail', 'Unincorporated')

	and State = 'New Hampshire'
-- 	and County = 'Mecklenburg County'
	-- 	and State = 'New Hampshire'
-- 	and town.name &lt;&gt; 'Unincorporated'
	group by region, country, State, County
	--, town.parent_arena_id
	order by region, country, State, County</sql><current_tab id="20"/></tab_sql></sqlb_project>
